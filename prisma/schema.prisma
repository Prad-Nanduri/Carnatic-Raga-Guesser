generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- BetterAuth required tables ----

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sessions       Session[]
  accounts       Account[]
  generationJobs GenerationJob[]
  tracks         Track[]
  trackLikes     TrackLike[]
  humMatches     HumMatch[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verifications")
}

// ---- Application tables ----

enum JobStatus {
  pending
  processing
  complete
  failed
}

enum GenerationMode {
  alapana // unmetered, tala-less raga elaboration (default)
  kriti   // composed, lyrics + tala
}

enum Instrument {
  voice
  violin
  veena
  venu_flute
  nadaswaram
  saxophone
  sitar_fusion // Hindustani-style (fusion), not native Carnatic
}

enum InputSource {
  manual_selection
  voice_sample
}

model GenerationJob {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  generationMode GenerationMode @default(alapana) @map("generation_mode")
  instrument     Instrument     @default(veena)
  durationSeconds Int           @default(10) @map("duration_seconds")
  inputSource    InputSource    @default(manual_selection) @map("input_source")
  engine         String         @default("procedural") // 'procedural' | 'musicgen' (experimental)
  ragaSuggestionConfidence Float? @map("raga_suggestion_confidence")
  humGuessedRaga String?  @map("hum_guessed_raga")
  humVerdict     String?  @map("hum_verdict") // 'right' | 'wrong' — user feedback on the guess
  lyrics    String?
  mood      String?
  genre     String?
  raga      String
  tala      String?
  status    JobStatus @default(pending)
  prompt    String?
  audioUrl  String?   @map("audio_url")
  errorMessage String? @map("error_message")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  tracks  Track[]
  metrics GenerationMetric[]

  @@index([userId])
  @@index([status])
  @@map("generation_jobs")
}

model Track {
  id              String        @id @default(cuid())
  generationJobId String        @map("generation_job_id")
  generationJob   GenerationJob @relation(fields: [generationJobId], references: [id], onDelete: Cascade)
  userId          String        @map("user_id")
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  raga            String
  tala            String?
  audioUrl        String        @map("audio_url")
  fileSizeBytes   BigInt?       @map("file_size_bytes")
  isPublic        Boolean       @default(false) @map("is_public")
  playCount       Int           @default(0) @map("play_count")
  createdAt       DateTime      @default(now()) @map("created_at")

  likes TrackLike[]

  @@index([generationJobId])
  @@index([userId])
  @@index([raga])
  @@index([isPublic, raga])
  @@map("tracks")
}

model GenerationMetric {
  id              String        @id @default(cuid())
  generationJobId String        @map("generation_job_id")
  generationJob   GenerationJob @relation(fields: [generationJobId], references: [id], onDelete: Cascade)
  startedAt       DateTime      @map("started_at")
  completedAt     DateTime?     @map("completed_at")
  durationMs      Int?          @map("duration_ms")
  status          JobStatus
  errorMessage    String?       @map("error_message")

  @@index([generationJobId])
  @@index([status])
  @@map("generation_metrics")
}

/**
 * A voice-sample raga match: the user hummed, we suggested ragas, they
 * confirmed (or not) and judged the guess. This is the centerpiece
 * record now — generation_jobs remains for legacy alapana data.
 */
model HumMatch {
  id            String   @id @default(cuid())
  userId        String?  @map("user_id") // nullable: anonymous matches allowed
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  guessedRaga   String   @map("guessed_raga")   // raga the matcher suggested/user picked
  confirmedRaga String?  @map("confirmed_raga") // raga the user says they meant
  confidence    Float?                            // matcher score 0..1
  verdict       String?  // 'right' | 'wrong'
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([guessedRaga])
  @@index([userId])
  @@map("hum_matches")
}

model TrackLike {
  id        String   @id @default(cuid())
  trackId   String   @map("track_id")
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([trackId, userId])
  @@index([userId])
  @@map("track_likes")
}
