# Neon Postgres connection string (pooled recommended for serverless)
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# BetterAuth
BETTER_AUTH_SECRET="generate-a-long-random-string"   # e.g. `openssl rand -base64 32`
BETTER_AUTH_URL="http://localhost:3000"              # set to your Vercel URL in prod

# GitHub OAuth app (optional — button hides when unset)
# https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
