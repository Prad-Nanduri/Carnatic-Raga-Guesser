# Neon Postgres connection string (pooled recommended for serverless)
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/ragaforge?sslmode=require"

# BetterAuth
BETTER_AUTH_SECRET="generate-a-long-random-string"   # e.g. `openssl rand -base64 32`
BETTER_AUTH_URL="http://localhost:3000"              # set to your Vercel URL in prod

# GitHub OAuth app (https://github.com/settings/developers)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="ragaforge-audio"

# Hugging Face Inference API (facebook/musicgen-small) — needs 'read' scope
HF_API_TOKEN=""
